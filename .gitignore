# Astra — Python / FastAPI AIOps Agent
# ── Environment ──────────────────────────────────────────────────────────────
.env
*.env.local

# ── Virtual Environment ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Pytest ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Build / Distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── Astra Runtime Databases (generated at runtime — never commit) ────────────
# These files contain sensitive investigation data and grow with every run.
astra_audit.db
astra_audit.db-shm
astra_audit.db-wal
astra_checkpoints.db
astra_checkpoints.db-shm
astra_checkpoints.db-wal

# ── ChromaDB Vector Store (generated by RAG service) ────────────────────────
.chroma_db/

# ── OS Junk & Helm ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
helm/**/*.tgz
helm/**/charts/
helm.exe
helm.zip
helm_unzipped/

