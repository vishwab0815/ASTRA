# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git — it is already in .gitignore.

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant   # optional override

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# CONFIDENCE_THRESHOLD=0.75   # auto-execute if confidence >= this value
# DRY_RUN=true                # set to false to allow real K8s write operations

# ── Slack (HITL Notifications) ────────────────────────────────────────────────
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# ── Database (Audit Trail) ────────────────────────────────────────────────────
# AUDIT_DB_PATH=astra_audit.db   # path to SQLite file (auto-created)
