# ==========================================
# Astra Backend Configuration (FastAPI)
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development  # development, staging, production
DEBUG=True

# Security
API_KEY_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telemetry & LLM Integration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database / Storage (if migrated from in-memory to persistent)
# DATABASE_URL=postgresql://user:pass@localhost:5432/astra
# REDIS_URL=redis://localhost:6379/0

# Astra Correlation Engine
STORM_THRESHOLD=10
FLAP_THRESHOLD=5
FLAP_WINDOW_SECONDS=300
